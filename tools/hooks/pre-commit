#!/bin/sh
# Keep index.qmd's {=html} tables tidy on the way into a commit: curl the quotes
# typed straight by hand, and give any new table row its permanent link id.
# Enabled with:  git config core.hooksPath tools/hooks
# Disabled with: git config --unset core.hooksPath

repo=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.qmd')
[ -z "$staged" ] && exit 0

cd "$repo" || exit 1
# shellcheck disable=SC2086
python3 tools/smarten-html-quotes.py $staged || exit 1
# Give any newly added table row a permanent id, so it can be linked to.
# shellcheck disable=SC2086
python3 tools/anchor-rows.py $staged || exit 1

for f in $staged; do
  git add -- "$f"
done
